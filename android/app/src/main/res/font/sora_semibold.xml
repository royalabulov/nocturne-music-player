<?xml version="1.0" encoding="utf-8"?>
<!-- Widget titles: Sora 600, the app's titleSm. The variable font file is a copy of
     assets/fonts/Sora.ttf (Flutter assets can't be referenced from Android resources). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/sora_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
