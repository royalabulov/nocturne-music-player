<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget (4×2): a small Now Playing. The cover as tall as the widget, then title,
     artist and favorite, the progress line, and shuffle · previous · play/pause · next · repeat. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Square: as wide as it is tall (adjustViewBounds with a square picture) -->
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_art_placeholder"
            android:importantForAccessibility="no"
            android:maxWidth="160dp"
            android:minWidth="88dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sora_semibold"
                        android:maxLines="1"
                        android:text="@string/widget_preview_title"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_preview_artist"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_favorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-8dp"
                    android:background="@drawable/widget_ripple"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_favorite_border"
                    android:tint="@color/widget_cyan" />
            </LinearLayout>

            <!-- Spacers are empty FrameLayouts: a plain View is not allowed in a home screen
                 widget (the launcher refuses the whole widget: "Couldn't add widget"). -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="420"
                android:progressDrawable="@drawable/widget_progress" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_shuffle"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ripple"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_shuffle"
                    android:tint="@color/widget_text_secondary" />

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ripple"
                    android:padding="7dp"
                    android:src="@drawable/ic_widget_previous" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_play_button"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_play" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ripple"
                    android:padding="7dp"
                    android:src="@drawable/ic_widget_next" />

                <ImageView
                    android:id="@+id/widget_repeat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ripple"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_repeat"
                    android:tint="@color/widget_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_stroke" />
</FrameLayout>
